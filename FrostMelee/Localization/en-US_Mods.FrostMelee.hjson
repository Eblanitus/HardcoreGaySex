	DisplayName: North Pole — provisional balance
	GrowthHits.Label: Successful swings to full charge
	BlessingSeconds.Label: Blessing duration (seconds)
	MoveSpeedPercent.Label: Movement speed bonus (%)
	RegenPerSecond.Label: Regeneration (HP/second)
	CritDamagePercent.Label: Critical multiplier bonus (%)
	WeakShotPercent.Label: Weak shot damage (%)
}
