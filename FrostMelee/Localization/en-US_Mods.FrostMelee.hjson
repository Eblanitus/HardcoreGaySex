ThrownTooltip: Thrown — walk up to the sickle to pick it up
ThrownTooltipSword: Thrown — walk up to the sword to pick it up
FrozenSpearName: Frozen Spear
IceBladeKindleTooltip:
	'''
	Chills enemies struck in frost, water, rain or a snow biome.
	Three chills set them ablaze with cold fire.
	Deals 18% more damage to burning enemies and makes the burn last 1s longer.
	Stabs lay two chills; a chilled enemy that runs onto the braced blade ignites;
	a sword stuck in the ground freezes everything around it.
	'''
FrostbrandKindleTooltip:
	'''
	Chills enemies struck in frost, water, rain or a snow biome.
	Three chills set them ablaze with cold fire.
	Each burning enemy struck lengthens the swing by 5px (up to 5 charges, 8s each).
	A burning enemy that dies ignites those nearby.
	Stabs lay two chills; a chilled enemy that runs onto the braced blade ignites;
	a sword stuck in the ground freezes everything around it.
	'''
YoyoControlsTooltip:
	'''
	LMB (hold): guide the yoyo
	RMB (hold): hunts the nearest enemy by itself, throws itself if out (LMB can go)
	LMB + RMB (hold): circle around you
	Hit: bounces back, closer hits faster. Ice grows, full ice bursts into shards.
	'''

YoyoMode: {
	Aim: Aim
	Homing: Locked on
	Circle: Circle
}

ControlsTooltip:
	'''
	LMB: swing (arc)
	RMB (tap): brace as a spear (damage scales with closing speed)
	RMB (hold): stabs
	RMB + LMB: throw (pick it up to use again)
	'''
SwordControlsTooltip:
	'''
	LMB: swing (sword arc)
	RMB (tap): hold the sword out (damage scales with closing speed)
	RMB (hold): stabs
	RMB + LMB: throw (the sword stays — go pick it up)
	'''

