FrozenSpearName: Frozen Spear
YoyoControlsTooltip:
	'''
	LMB (hold): guide the yoyo
	RMB (hold): hunts the nearest enemy by itself, throws itself if out (LMB can go)
	LMB + RMB (hold): circle around you
	Hit: bounces back, closer hits faster. Ice grows, full ice bursts into shards.
	'''

YoyoMode: {
	Aim: Aim
	Homing: Locked on
	Circle: Circle
}

ControlsTooltip:
	'''
	LMB: swing (arc)
	RMB (tap): brace as a spear (damage scales with closing speed)
	RMB (hold): stabs
	RMB + LMB: throw (pick it up to use again)
	'''
SwordControlsTooltip:
	'''
	LMB: swing (sword arc)
	RMB (tap): hold the sword out (damage scales with closing speed)
	RMB (hold): stabs
	RMB + LMB: throw (the sword stays — go pick it up)
	'''
BoomerangControlsTooltip:
	'''
	LMB (hold): endless light throws — weak, trailing a cold vortex, they come back on their own
	RMB: backswing — hits point blank and spins up your next throw
	RMB (hold): charge with an aim line, release — heavy throw (slides like a puck, floats in water, go pick it up)
	Nothing flies through walls
	'''

Configs: {
	FrostMeleeConfig: {
		DisplayName: Frost Melee Config

		ShowStanceIndicator: {
			Label: Показывать режим атаки над головой
			Tooltip: Отключает надпись приёма (Взмах/Тычок/Копьё/Брошено/Точка/Наведён/Круг) над персонажем.
		}

		ShowControlTooltips: {
			Label: Подсказки управления в описании
			Tooltip: Отключает списки приёмов в тултипах оружия.
		}

		FrostFireIntensity: {
			Label: Ядрёность ледяного огня (%)
			Tooltip: Сколько самого синего пламени Frostbrand и насколько оно горячее. По умолчанию 50: основное пламя уже есть на самом мече, а живой огонь вокруг него должен быть еле заметным.
		}

		FrostBraceJetLengthPercent: {
			Label: Длина струи встречи (%)
			Tooltip: Временная настройка для подбора длины струи Frostbrand во встрече. 100 — прежняя длина, сейчас стоит 60 — примерно на 40% короче.
		}
	}
}

PrototypeNotice: Prototype: temporary stats and artwork, unique mechanics pending
TreeSwordPrototypeNotice: Rework scaffold: shared sword moves, unique mechanics pending
ThrownTooltipSpear: Spear thrown — walk up to it to pick it up
BaseSpearControlsTooltip:
	'''
	LMB: circular swing
	Tap RMB: toggle braced spear
	Hold RMB: thrusts
	RMB + LMB: throw; walk up to the spear to pick it up
	'''
SharedFlailControlsTooltip: LMB: piercing throw, stronger up close; hold to repeat. RMB: spin with a 1.5-second wind-up. No head drop. RMB + one LMB click casts along your aim and quickly wraps an enemy on its path automatically. Both buttons can be released after launch. A full wrap immediately triggers an automatic yank — no second click needed. Bosses and knockback-immune targets cannot be bound. Switch weapons to cancel the lasso.

LassoStatus: {
    Approaching: Lasso: approaching the target orbit
    Interrupted: Lasso: cancelled by weapon switch or incapacitation
    LostTarget: Lasso: target lost
    Timeout: Lasso: attempt timed out
	Casting: Lasso v8: head cast — looking for an enemy on the flight path
	NoTarget: Lasso v8: hold RMB and CLICK LMB to cast along your aim
	Ineligible: Lasso: this target cannot be bound (boss, dummy, immunity or segment)
	Occupied: Lasso: target is already bound
	TooShort: Lasso: not enough chain for the path and loop — move closer
	Blocked: Lasso: obstacle blocks the wrap
	Ready: Lasso: keep RMB held and CLICK LMB to cast and wrap
	Wrapping: Lasso: quick automatic wrap — buttons can be released
	Bound: Lasso: target bound — automatic yank
	Yanking: Lasso: yanking
	Returning: Lasso: head returning
	NeedSpin: Lasso: release LMB, wait for the head to return, then hold RMB
}

