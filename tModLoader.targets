<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Override with /p:TModLoaderPath=... or the TModLoaderPath environment variable. -->
  <PropertyGroup>
    <TModLoaderPath Condition="'$(TModLoaderPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\tModLoader</TModLoaderPath>
  </PropertyGroup>
  <Import Project="$(TModLoaderPath)/tMLMod.targets" />
</Project>
